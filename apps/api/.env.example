# MongoDB Atlas connection string (a free M0 cluster works — see DEPLOYMENT.md). Must include a
# database name in the path (e.g. "/servicedesk") and Atlas clusters must run as a replica set
# (all Atlas tiers, including M0, do by default) for Prisma's $transaction calls to work.
DATABASE_URL="mongodb+srv://user:pass@cluster0.mongodb.net/servicedesk?retryWrites=true&w=majority"
# A SEPARATE, disposable database for `npm run test` — the suite drops it completely before every
# run (see test/globalSetup.ts). Same cluster as DATABASE_URL is fine; just use a different
# database name in the path, e.g. "/servicedesk_test". Required to run tests at all.
TEST_DATABASE_URL="mongodb+srv://user:pass@cluster0.mongodb.net/servicedesk_test?retryWrites=true&w=majority"
JWT_ACCESS_SECRET=change-me-access
JWT_REFRESH_SECRET=change-me-refresh
PORT=4000
CORS_ORIGIN=http://localhost:5173
NODE_ENV=development
# Login attempts allowed per IP per 15 minutes. Default (200) is sized for an internal tool and
# for the committed Playwright suite logging in repeatedly; tighten this (e.g. 10-20) for an
# internet-facing deployment.
LOGIN_RATE_LIMIT=200
# Only needed in production (see src/seed/bootstrap.ts) — creates the first Master Admin account
# on a fresh database. Leave unset locally; `npm run seed` creates demo accounts instead.
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_PASSWORD=
BOOTSTRAP_ADMIN_NAME=
